# Normalize line endings to LF for all text files, regardless of the
# committing/checking-out machine's OS or local autocrlf setting.
# This stops Git from converting files to CRLF on Windows checkouts,
# which otherwise causes diff noise and cross-platform commit thrashing.

* text=auto eol=lf

*.js  text eol=lf
*.html text eol=lf
*.css text eol=lf
*.md  text eol=lf
*.json text eol=lf

# Binary files — do not touch line endings at all
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.zip binary
